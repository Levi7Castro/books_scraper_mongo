# Airflow (usuário admin da UI)
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=
AIRFLOW_EMAIL=admin@example.com

# MongoDB (usuário root)
MONGO_USER=admin
MONGO_PASSWORD=

# Postgres (metadados do Airflow)
POSTGRES_PASSWORD=

# Chave Fernet: criptografa senhas de Connections/Variables do Airflow
# gere com: python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_FERNET_KEY=

# UID do seu usuário no host (id -u) — permite ao Airflow escrever em ./data
AIRFLOW_UID=1000
